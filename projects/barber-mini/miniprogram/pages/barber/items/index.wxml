<view class="bg">
  <view class="bg__blob bg__blob--a"></view>
  <view class="bg__blob bg__blob--c"></view>
</view>

<view class="page">
  <view class="row row--between" style="margin:6rpx 4rpx 26rpx">
    <view>
      <view class="lbl">价格与时长都归你改</view>
      <view class="h1">服务项目</view>
    </view>
    <view class="pill pill--gold" id="newBtn" bindtap="openNew">＋ 新增</view>
  </view>

  <!-- 编辑区 -->
  <view class="glass" wx:if="{{edit}}">
    <view class="sec"><view class="sec__bar"></view><text class="sec__t" style="font-size:30rpx">{{edit === 'new' ? '新增项目' : '编辑项目'}}</text></view>
    <view class="field"><text class="lbl">名称</text><input class="inp" value="{{form.name}}" data-k="name" bindinput="onInput" placeholder="例：剪发" /></view>
    <view class="row row--gap mt16">
      <view class="field grow"><text class="lbl">价格(元)</text><input class="inp" type="number" value="{{form.price}}" data-k="price" bindinput="onInput" /></view>
      <view class="field grow"><text class="lbl">时长(分钟)</text><input class="inp" type="number" value="{{form.min}}" data-k="min" bindinput="onInput" /></view>
    </view>
    <view class="row row--gap mt20">
      <view class="btn btn--ghost grow" id="cancelEdit" bindtap="close">取消</view>
      <view class="btn btn--gold grow" id="saveBtn" bindtap="save">{{saving ? '保存中…' : '保存'}}</view>
    </view>
  </view>

  <view class="glass">
    <view class="sec"><view class="sec__bar"></view><text class="sec__t" style="font-size:30rpx">项目列表</text><text class="muted grow" style="text-align:right">点一行编辑</text></view>
    <block wx:if="{{list.length}}">
      <view class="item" wx:for="{{list}}" wx:key="_id">
        <view class="item__ico ico ico--{{item.icon}}"></view>
        <view class="grow" id="edit-{{item._id}}" data-id="{{item._id}}" bindtap="openEdit">
          <view class="item__t">{{item.name}}{{item.on ? '' : '（已下架）'}}</view>
          <view class="item__s">{{item.min}} 分钟 · ¥{{item.price}}</view>
        </view>
        <view class="pill {{item.on ? 'pill--free' : ''}}" id="toggle-{{item._id}}" data-id="{{item._id}}" bindtap="toggle">{{item.on ? '上架中' : '已下架'}}</view>
      </view>
    </block>
    <view wx:else class="center" style="padding:26rpx 0"><text class="muted">还没有项目，点右上「＋ 新增」</text></view>
  </view>

  <view class="glass glass--tight">
    <text class="muted">提示：下架不删数据（历史单照常保留）；时长会在顾客预约时用来锁时段。</text>
  </view>
</view>
