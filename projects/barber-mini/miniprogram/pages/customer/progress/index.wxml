<view class="bg">
  <view class="bg__blob bg__blob--a"></view>
  <view class="bg__blob bg__blob--b"></view>
  <view class="bg__blob bg__blob--c"></view>
</view>

<view class="page">
  <view class="head">
    <view class="head__ava">{{me.initial}}</view>
    <view class="grow">
      <view class="head__name">{{me.serviceName || "排队中"}}</view>
      <view class="head__sub">{{me.tag}} · 更新于 {{updated}}</view>
    </view>
    <view class="pill {{me.tagClass}}">{{me.statusText}}</view>
  </view>

  <!-- 主卡：我的位置 + 倒计时 -->
  <view class="glass glass--dark">
    <view class="row row--between">
      <view class="grow">
        <view class="lbl" style="color:rgba(255,255,255,.62)">我的排位</view>
        <view class="row" style="align-items:flex-end;margin-top:6rpx">
          <text class="num" style="color:#fff">第 {{ahead + 1}}</text>
          <text class="muted" style="color:rgba(255,255,255,.7);margin:0 0 14rpx 12rpx">位</text>
        </view>
        <view class="muted" style="color:rgba(255,255,255,.75)">前面还有 {{ahead}} 位 · 预计 {{etaMin}} 分钟</view>
      </view>
      <view class="center">
        <view class="num" style="color:#fff">{{leftMin}}</view>
        <view class="lbl" style="color:rgba(255,255,255,.62)">分钟后</view>
      </view>
    </view>
    <view class="bar mt20" style="background:rgba(255,255,255,.18)">
      <view class="bar__in" style="width:{{progressPct}}%"></view>
    </view>
    <view class="row row--between mt12">
      <text class="muted" style="color:rgba(255,255,255,.72)">{{me.statusText === '服务中' ? '正在为你服务' : '叫到你会有提醒'}}</text>
      <text class="muted" style="color:rgba(255,255,255,.72)">倒计时 {{countdown}}</text>
    </view>
  </view>

  <!-- 三瓦片 -->
  <view class="tiles">
    <view class="tile"><view class="tile__k">前面人数</view><view class="tile__v">{{ahead}}<text class="tile__u">人</text></view></view>
    <view class="tile"><view class="tile__k">预计等待</view><view class="tile__v">{{etaMin}}<text class="tile__u">分钟</text></view></view>
    <view class="tile"><view class="tile__k">队伍总长</view><view class="tile__v">{{list.length}}<text class="tile__u">人</text></view></view>
  </view>

  <!-- 前面的人 -->
  <view class="glass mt24">
    <view class="sec">
      <view class="sec__bar"></view>
      <text class="sec__t" style="font-size:30rpx">前面的人</text>
      <text class="muted grow" style="text-align:right">按优先级 · 先到先得</text>
    </view>
    <block wx:if="{{front.length}}">
      <view class="item" wx:for="{{front}}" wx:key="_id">
        <view class="rank">{{index + 1}}</view>
        <view class="grow">
          <view class="item__t">{{item.customerName}}</view>
          <view class="item__s">{{item.serviceName}} · {{item.statusText}}</view>
        </view>
        <view class="pill {{item.tagClass}}">{{item.tag}}</view>
      </view>
    </block>
    <view wx:else class="center" style="padding:26rpx 0"><text class="muted">前面没人，马上轮到你</text></view>
  </view>

  <!-- 说明 -->
  <view class="glass glass--tight">
    <view class="row row--gap">
      <view class="dot dot--busy" style="margin-top:12rpx"></view>
      <text class="muted grow">预付款用户仅在同一时间段内优先；跨时段按先来后到，不会插队。到号前会给你发一条提醒。</text>
    </view>
  </view>

  <view class="grid2">
    <view class="btn btn--ghost" id="backBtn" bindtap="back">返回首页</view>
    <view class="btn btn--gold" id="cancelBtn" bindtap="cancel">取消排队</view>
  </view>
</view>
