/* ── 设计系统（一处定义，六页共用）────────────────────────────────────────────
   风格：扁平 + 简约 + 毛玻璃半透明；深灰墨 + 金点缀；状态色只用于状态。
   层级：背景光斑 → 玻璃卡 → 内容；数字用重字重，标签用弱色。              */

page {
  --ink: #14161A;
  --ink-2: #3A3F47;
  --ink-3: #7C838E;
  /* ★ 2026-09-14 苹果风配色（老板：配色太差劲）——中性灰 + 系统蓝/绿/橙，**没有红色** */
  --gold: #0A84FF;      /* 主色 = iOS 系统蓝 */
  --gold-2: #4DA2FF;
  --free: #34C759;      /* 空闲 = iOS 绿 */
  --busy: #FF9F0A;      /* 忙/服务中 = iOS 橙 */
  --rest: #30B36B;      /* 休息/打烊 = 绿（不要红） */
  --glass: rgba(255, 255, 255, 0.58);
  --glass-2: rgba(255, 255, 255, 0.42);
  --glass-line: rgba(255, 255, 255, 0.75);
  --stroke: rgba(20, 22, 26, 0.08);
  --shadow: 0 8rpx 32rpx rgba(20, 22, 26, 0.10);
  --radius: 28rpx;

  background: #EEF1F6;
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* 背景光斑：毛玻璃要透出层次才好看 */
.bg { position: fixed; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; z-index: 0; }
.bg__blob { position: absolute; border-radius: 50%; filter: blur(70rpx); opacity: .95; }
.bg__blob--a { width: 700rpx; height: 700rpx; left: -220rpx; top: -180rpx;
  background: radial-gradient(circle at 35% 35%, #FFDE7A, #FFC93C 45%, rgba(255,201,60,0) 72%); }
.bg__blob--b { width: 820rpx; height: 820rpx; right: -300rpx; top: 260rpx;
  background: radial-gradient(circle at 60% 40%, #9FC2FF, #6E9BFF 45%, rgba(110,155,255,0) 72%); }
.bg__blob--c { width: 760rpx; height: 760rpx; left: -180rpx; bottom: -240rpx;
  background: radial-gradient(circle at 40% 60%, #9CEBC4, #57D79E 45%, rgba(87,215,158,0) 72%); }

.page { position: relative; z-index: 1; padding: 30rpx 30rpx 240rpx; }

/* ── 页头（替代与导航重复的标题）── */
.head { display: flex; align-items: center; gap: 22rpx; margin: 10rpx 4rpx 32rpx; }
.head__ava { width: 92rpx; height: 92rpx; border-radius: 30rpx; display: flex; align-items: center;
  justify-content: center; font-size: 38rpx; font-weight: 700; color: #2A2205;
  background: linear-gradient(135deg, #F6E7B4, #C9A227); box-shadow: 0 10rpx 24rpx rgba(201,162,39,.35); }
.head__name { font-size: 40rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.head__sub { font-size: 24rpx; color: var(--ink-3); margin-top: 6rpx; }

/* ── 分区标题（金色短竖条，比纯文字有层次）── */
.sec { display: flex; align-items: center; gap: 16rpx; margin-bottom: 26rpx; }
.sec__bar { width: 8rpx; height: 30rpx; border-radius: 4rpx; background: linear-gradient(180deg, var(--gold-2), var(--gold)); }
.sec__t { font-size: 32rpx; font-weight: 700; }

/* ── 横向时间带（今日可约）── */
.tl { display: flex; gap: 14rpx; overflow-x: auto; padding: 0 8rpx 6rpx 0; }
.tl__i { flex: 0 0 auto; min-width: 126rpx; padding: 22rpx 0; text-align: center; border-radius: 20rpx;
  font-size: 26rpx; font-weight: 600; }
.tl__i--free { background: rgba(23,178,106,.14); color: #0E7A48; }
.tl__i--busy { background: rgba(20,22,26,.08); color: #9AA1AC; }
.tl__i--now { background: linear-gradient(135deg, var(--gold-2), var(--gold)); color: #2A2205; }

/* ── 头像条（排队里的人）── */
.faces { display: flex; align-items: center; }
.face { width: 54rpx; height: 54rpx; border-radius: 50%; margin-left: -14rpx; border: 3rpx solid rgba(255,255,255,.85);
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #2A2205;
  background: linear-gradient(135deg, #F6E7B4, #E8C766); }
.face:first-child { margin-left: 0; }

/* ── 玻璃卡 ── */
.glass {
  background: var(--glass);
  backdrop-filter: blur(24rpx) saturate(140%);
  -webkit-backdrop-filter: blur(24rpx) saturate(140%);
  border: 1rpx solid var(--glass-line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 34rpx;
  margin-bottom: 30rpx;
}
.glass--tight { padding: 26rpx 30rpx; }
.glass--dark { background: rgba(20, 22, 26, 0.78); color: #fff; border-color: rgba(255,255,255,0.12); }

/* ── 排版 ── */
.h1 { font-size: 44rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.h2 { font-size: 34rpx; font-weight: 600; }
.lbl { font-size: 24rpx; color: var(--ink-3); letter-spacing: 1rpx; }
.muted { color: var(--ink-3); font-size: 24rpx; }
.num { font-size: 56rpx; font-weight: 700; letter-spacing: -1rpx; }
.num--sm { font-size: 36rpx; font-weight: 700; }
.row { display: flex; align-items: center; }
.row--between { justify-content: space-between; }
.row--gap { gap: 16rpx; }
.col { display: flex; flex-direction: column; }
.grow { flex: 1; }

/* ── 药丸 / 徽标 ── */
.pill { display: inline-flex; align-items: center; gap: 8rpx; padding: 8rpx 18rpx;
  border-radius: 999rpx; font-size: 22rpx; background: rgba(20,22,26,0.06); color: var(--ink-2); }
.pill--gold { background: linear-gradient(135deg, #F6E7B4, #E8C766); color: #6B5210; font-weight: 600; }
.pill--free { background: rgba(23,178,106,0.14); color: #0E7A48; }
.pill--busy { background: rgba(240,160,32,0.22); color: #7A4E00; font-weight: 600; }
.pill--rest { background: rgba(47,163,122,0.16); color: #14654A; }

/* ── 统一线性图标（替代 emoji，风格一致；颜色跟金色系）── */
.ico { background-repeat: no-repeat; background-position: center; background-size: 46rpx 46rpx; }
.ico--scissors { background-image: url("data:image/svg+xml;base64,"); }
.ico--perm { background-image: url("data:image/svg+xml;base64,"); }
.ico--dye { background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjOEE2RDEyIiBzdHJva2Utd2lkdGg9IjEuOCIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNMTIgM3M2IDcgNiAxMWE2IDYgMCAwIDEtMTIgMGMwLTQgNi0xMSA2LTExeiIvPjwvc3ZnPg=="); }
.ico--care { background-image: url("data:image/svg+xml;base64,"); }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.dot--free { background: var(--free); }
.dot--busy { background: var(--busy); }
.dot--rest { background: var(--rest); }
.dot--pulse { animation: pulse 1.6s ease-in-out infinite; }
@keyframes pulse { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.35); opacity: .6; } }

/* ── 按钮 ── */
.btn { height: 100rpx; line-height: 100rpx; border-radius: 24rpx; text-align: center;
  font-size: 32rpx; font-weight: 600; letter-spacing: 1rpx; }
.btn--gold { background: linear-gradient(135deg, var(--gold-2), var(--gold)); color: #2A2205;
  box-shadow: 0 10rpx 28rpx rgba(201,162,39,0.35); }
.btn--dark { background: var(--ink); color: #fff; }
.btn--ghost { background: var(--glass-2); border: 1rpx solid var(--glass-line); color: var(--ink); }
.btn--disabled { opacity: .45; }
.btn--sm { height: 72rpx; line-height: 72rpx; font-size: 26rpx; border-radius: 18rpx; }

/* ── 统计瓦片：看板用小而密的块 ── */
.tiles { display: flex; gap: 16rpx; }
.tile { flex: 1; background: var(--glass-2); border: 1rpx solid var(--glass-line);
  border-radius: 24rpx; padding: 28rpx 24rpx;
  backdrop-filter: blur(16rpx); -webkit-backdrop-filter: blur(16rpx); }
.tile__k { font-size: 22rpx; color: var(--ink-3); }
.tile__v { font-size: 42rpx; font-weight: 700; margin-top: 14rpx; }
.tile__u { font-size: 22rpx; color: var(--ink-3); margin-left: 6rpx; font-weight: 400; }

/* ── 列表行 ── */
.item { display: flex; align-items: center; gap: 22rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--stroke); }
.item:first-child { padding-top: 8rpx; }
.item:last-child { border-bottom: none; }
.item__ico { width: 84rpx; height: 84rpx; border-radius: 24rpx; display: flex; align-items: center;
  justify-content: center; font-size: 34rpx; background-color: #FBF2D8; }
/* ⚠️ 这里只能用 background-color：用 `background:` 简写会把下面 .ico--* 的图标 background-image 一起清掉
   （实测：图标变成空框——层叠顺序在 .item__ico 之后被重置）。 */
.item__t { font-size: 30rpx; font-weight: 600; }
.item__s { font-size: 24rpx; color: var(--ink-3); margin-top: 4rpx; }

/* ── 进度条 ── */
.bar { height: 14rpx; border-radius: 999rpx; background: rgba(20,22,26,0.08); overflow: hidden; }
.bar__in { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, var(--gold-2), var(--gold)); }

/* ── 分段控件 ── */
.seg { display: flex; background: rgba(20,22,26,0.06); border-radius: 20rpx; padding: 6rpx; }
.seg__i { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 16rpx; font-size: 26rpx; color: var(--ink-2); }
.seg__i--on { background: #fff; box-shadow: 0 4rpx 14rpx rgba(20,22,26,.10); font-weight: 600; color: var(--ink); }

/* ── 时间轴格子 ── */
.slots { display: flex; flex-wrap: wrap; gap: 14rpx; }
.slot { min-width: 148rpx; padding: 20rpx 0; text-align: center; border-radius: 20rpx;
  font-size: 26rpx; font-weight: 600; }
.slot--free { background: rgba(23,178,106,0.12); color: #0E7A48; border: 1rpx solid rgba(23,178,106,0.25); }
.slot--busy { background: rgba(20,22,26,0.06); color: #9AA1AC; }
.slot--on { background: linear-gradient(135deg, var(--gold-2), var(--gold)); color: #2A2205; border-color: transparent; }

/* ── 布局工具 ── */
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.entry { background: var(--glass-2); border: 1rpx solid var(--glass-line); border-radius: 24rpx;
  padding: 26rpx 24rpx; backdrop-filter: blur(16rpx); -webkit-backdrop-filter: blur(16rpx); }
.entry__t { font-size: 30rpx; font-weight: 700; }
.entry__s { font-size: 22rpx; color: var(--ink-3); margin-top: 8rpx; }
.grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16rpx; }
.grid4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 14rpx; }
.stick { position: fixed; left: 24rpx; right: 24rpx; bottom: 32rpx; z-index: 5; }
.divider { height: 1rpx; background: var(--stroke); margin: 20rpx 0; }
.center { text-align: center; }
.mt8 { margin-top: 8rpx; } .mt12 { margin-top: 12rpx; } .mt16 { margin-top: 16rpx; }
.mt20 { margin-top: 20rpx; } .mt24 { margin-top: 24rpx; }

/* ══ 极简版 V1（老板 2026-09-14 要求另起一套，留作备份）══════════════════════
   **逻辑、信息架构、色系与毛玻璃版完全一致**，只换观感：
   · 纯白卡片、无模糊、无投影、无光斑；描边细、留白多、圆角小；
   · 颜色仍只 墨灰 + 金 + 三态色（忙橙 / 空闲绿 / 打烊绿），**依旧没有红色**。 */
.theme--minimal { background: #FFFFFF; }
.theme--minimal .bg { display: none; }
.theme--minimal .glass {
  background: #FFF; backdrop-filter: none; -webkit-backdrop-filter: none;
  border: 1rpx solid #EDEDED; box-shadow: none; border-radius: 16rpx; padding: 30rpx; }
.theme--minimal .glass--dark { background: #1B1D21; border-color: #1B1D21; }
.theme--minimal .glass--tight { padding: 24rpx 26rpx; }
.theme--minimal .tile, .theme--minimal .entry, .theme--minimal .tl24 {
  background: #FFF; border: 1rpx solid #EDEDED; box-shadow: none; backdrop-filter: none;
  -webkit-backdrop-filter: none; border-radius: 16rpx; }
.theme--minimal .btn { border-radius: 12rpx; box-shadow: none; height: 96rpx; line-height: 96rpx; }
.theme--minimal .btn--gold { background: var(--gold); }
.theme--minimal .btn--ghost { background: #FFF; border: 1rpx solid #DADADA; }
.theme--minimal .pill { background: #F5F5F5; }
.theme--minimal .head__ava, .theme--minimal .ava { background: var(--gold); color: #fff; box-shadow: none; border-radius: 16rpx; }
.theme--minimal .item__ico, .theme--minimal .pick, .theme--minimal .type { background: #FAFAFA; border: 1rpx solid #EDEDED; border-radius: 14rpx; }
.theme--minimal .pick--on, .theme--minimal .type--on { border-color: var(--gold); background: #FFF9E8; }
.theme--minimal .status, .theme--minimal .hero { box-shadow: none; border-radius: 16rpx; }
.theme--minimal .seg { background: #F3F3F3; border-radius: 12rpx; }
.theme--minimal .seg__i { border-radius: 10rpx; }
.theme--minimal .seg__i--on { background: #FFF; box-shadow: none; border: 1rpx solid #E6E6E6; }
.theme--minimal .bar { background: #F0F0F0; height: 10rpx; }
.theme--minimal .tlbar__seg { border-radius: 8rpx; }

/* ── 线条拟物头像（老板：不要 emoji，要"只有线条和颜色"的简约头像）── */
.ava-line { background-repeat: no-repeat; background-position: center; background-size: 100% 100%; }
.ava-line--woman { background-image: url("data:image/svg+xml;base64,"); }
.ava-line--man { background-image: url("data:image/svg+xml;base64,"); }
.ava-line--elder { background-image: url("data:image/svg+xml;base64,"); }
.ava-line--child { background-image: url("data:image/svg+xml;base64,"); }
