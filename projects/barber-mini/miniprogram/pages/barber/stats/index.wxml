<view class="bg">
  <view class="bg__blob bg__blob--b"></view>
  <view class="bg__blob bg__blob--c"></view>
</view>

<view class="page">
  <view class="row row--between" style="margin-bottom:22rpx">
    <view>
      <view class="lbl">经营数据</view>
      <view class="h1">统计</view>
    </view>
    <view class="pill pill--gold">本周</view>
  </view>

  <view class="tiles">
    <view class="tile"><view class="tile__k">完成单数</view><view class="tile__v">{{s.completedCount}}<text class="tile__u">单</text></view></view>
    <view class="tile"><view class="tile__k">收入</view><view class="tile__v">{{revenueYuan}}<text class="tile__u">元</text></view></view>
    <view class="tile"><view class="tile__k">平均耗时</view><view class="tile__v">{{avgMin}}<text class="tile__u">分</text></view></view>
  </view>

  <view class="glass mt24">
    <view class="row row--between">
      <text class="h2">按项目</text>
      <text class="muted">单数 · 平均耗时</text>
    </view>
    <view class="chart mt20">
      <view class="chart__row" wx:for="{{bars}}" wx:key="name">
        <text class="chart__k">{{item.name}}</text>
        <view class="chart__track"><view class="chart__bar" style="width:{{item.pct}}%"></view></view>
        <text class="chart__v">{{item.count}} 单 / {{item.avgMin}} 分</text>
      </view>
    </view>
  </view>

  <view class="glass">
    <view class="row row--between">
      <text class="h2">按客人属性</text>
      <text class="muted">占比</text>
    </view>
    <view class="row row--gap mt20">
      <view class="donut">
        <view class="donut__in">
          <view class="num--sm">{{s.completedCount}}</view>
          <view class="lbl">总单</view>
        </view>
      </view>
      <view class="grow">
        <view class="legend" wx:for="{{types}}" wx:key="k">
          <view class="dot" style="background:{{item.color}}"></view>
          <text class="grow">{{item.label}}</text>
          <text class="num--sm" style="font-size:30rpx">{{item.count}}</text>
          <text class="muted" style="width:90rpx;text-align:right">{{item.pct}}%</text>
        </view>
      </view>
    </view>
  </view>

  <view class="glass">
    <view class="row row--between">
      <text class="h2">按时段</text>
      <text class="muted">近 7 天</text>
    </view>
    <view class="bars mt20">
      <view class="bars__i" wx:for="{{days}}" wx:key="d">
        <view class="bars__b" style="height:{{item.h}}rpx"></view>
        <text class="lbl">{{item.d}}</text>
      </view>
    </view>
  </view>
</view>
