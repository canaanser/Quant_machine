.sw { height: 100vh; }
.pane { height: 100%; padding: 24rpx 24rpx 0; box-sizing: border-box; }

/* 第一屏：手上几位（最醒目） */
.hero { border-radius: 32rpx; padding: 36rpx; color: #fff; margin-bottom: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(20,22,26,.22); }
.hero--free { background: linear-gradient(135deg, #1FC777, #17B26A); }
.hero--busy { background: linear-gradient(135deg, #F5B740, #F0A020); }
.hero--rest { background: linear-gradient(135deg, #3FBF93, #2FA37A); }
.status--rest { background: linear-gradient(135deg, #3FBF93, #2FA37A); }
.hero__k { font-size: 24rpx; opacity: .85; }
.hero__n { font-size: 96rpx; font-weight: 800; line-height: 1; }
.hero__u { font-size: 30rpx; opacity: .9; margin: 0 0 14rpx 10rpx; }
.hero__right { text-align: right; }
.hero__st { font-size: 32rpx; font-weight: 700; }
.hero__sub { font-size: 24rpx; opacity: .85; margin-top: 10rpx; }

/* 现在这位 */
.now { display: flex; align-items: center; gap: 22rpx; background: var(--glass);
  border: 1rpx solid var(--glass-line); border-radius: 28rpx; padding: 26rpx 28rpx;
  box-shadow: var(--shadow); backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx); }
.now__ava { width: 108rpx; height: 108rpx; border-radius: 34rpx; display: flex; align-items: center;
  justify-content: center; background: #F2F7FF; border: 1rpx solid #E3ECF9; padding: 12rpx; }
.now__name { font-size: 40rpx; font-weight: 700; }
.now__meta { font-size: 26rpx; color: var(--ink-3); margin-top: 6rpx; }
.now__min { font-size: 44rpx; font-weight: 800; color: var(--gold); }
.now__minu { font-size: 24rpx; color: var(--ink-3); margin-left: 4rpx; font-weight: 400; }

/* 排队头像条 */
.strip { margin-top: 24rpx; }
.strip__in { white-space: nowrap; }
.face-card { display: inline-flex; flex-direction: column; align-items: center; width: 132rpx;
  margin-right: 16rpx; padding: 18rpx 0; border-radius: 22rpx; background: var(--glass-2);
  border: 1rpx solid var(--glass-line); }
.face-card__ava { width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center;
  justify-content: center; background: #F2F7FF; border: 1rpx solid #E3ECF9; padding: 8rpx; }
.face-card__ava--woman { background: #FFE3EF; }
.face-card__ava--man { background: #E3EEFF; }
.face-card__ava--elder { background: #EFE7DC; }
.face-card__ava--child { background: #DFF6E6; }
.face-card__name { font-size: 24rpx; margin-top: 10rpx; max-width: 120rpx; overflow: hidden; }
.face-card__svc { font-size: 22rpx; color: var(--ink-3); margin-top: 4rpx; }

/* 拇指区：完成本单常驻 */
.thumbbar { position: absolute; left: 24rpx; right: 24rpx; bottom: 28rpx; }
.thumbbtn { height: 120rpx; line-height: 120rpx; font-size: 38rpx; border-radius: 30rpx; }

/* 接力条（完成本单后滑出）：上拖=继续，1 秒不动=休息 */
.relay { margin-top: 16rpx; padding: 20rpx; border-radius: 26rpx;
  background: rgba(20,22,26,.88); color: #fff; transform: translateY(40rpx); opacity: 0;
  transition: all .28s ease-out; }
.relay--in { transform: translateY(0); opacity: 1; }
.relay__bar { height: 8rpx; border-radius: 999rpx; background: rgba(255,255,255,.22); overflow: hidden; }
.relay__fill { height: 100%; background: linear-gradient(90deg, var(--gold-2), var(--gold)); transition: width .2s linear; }
.relay__row { margin-top: 16rpx; }
.relay__card { display: flex; align-items: center; gap: 18rpx; padding: 18rpx 20rpx; border-radius: 22rpx;
  background: rgba(255,255,255,.12); border: 1rpx solid rgba(255,255,255,.22); }   /* ★ 拖动时不要 transition：那是"不跟手"的元凶 */
.relay__ava { width: 76rpx; height: 76rpx; border-radius: 24rpx; display: flex; align-items: center;
  justify-content: center; background: rgba(255,255,255,.92); padding: 8rpx; }
.relay__hint { font-size: 22rpx; color: var(--gold-2); }
.relay__foot { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }

/* 第二屏工具 */
.type { padding: 20rpx 0; border-radius: 22rpx; text-align: center;
  background: rgba(255,255,255,.55); border: 1rpx solid var(--glass-line); }
.type--on { border-color: var(--gold); background: rgba(255,246,218,.9); }
.type__ico { font-size: 40rpx; }
.type__t { font-size: 24rpx; margin-top: 6rpx; color: var(--ink-2); }
.rank { width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; border-radius: 16rpx;
  background: rgba(20,22,26,.06); color: var(--ink-3); font-weight: 700; font-size: 26rpx; }
.rank--on { background: linear-gradient(135deg, var(--gold-2), var(--gold)); color: #2A2205; }
