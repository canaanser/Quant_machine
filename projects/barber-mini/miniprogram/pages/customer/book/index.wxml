<view class="bg">
  <view class="bg__blob bg__blob--a"></view>
  <view class="bg__blob bg__blob--b"></view>
</view>

<view class="page">
  <view class="row row--between" style="margin-bottom:22rpx">
    <view>
      <view class="lbl">阿明理发</view>
      <view class="h1">预约</view>
    </view>
    <view class="pill pill--gold">第 {{step}} / 3 步</view>
  </view>

  <!-- 步骤指示 -->
  <view class="glass glass--tight">
    <view class="row row--between">
      <view class="step {{step >= 1 ? 'step--on' : ''}}"><text class="step__n">1</text><text class="step__t">时间</text></view>
      <view class="step__line {{step >= 2 ? 'step__line--on' : ''}}"></view>
      <view class="step {{step >= 2 ? 'step--on' : ''}}"><text class="step__n">2</text><text class="step__t">项目</text></view>
      <view class="step__line {{step >= 3 ? 'step__line--on' : ''}}"></view>
      <view class="step {{step >= 3 ? 'step--on' : ''}}"><text class="step__n">3</text><text class="step__t">客人</text></view>
    </view>
  </view>

  <!-- 第 1 步：时间 -->
  <view class="glass" wx:if="{{step === 1}}">
    <view class="row row--between">
      <text class="h2">选时间</text>
      <text class="muted">绿=可约 · 灰=已约</text>
    </view>
    <view class="slots mt20">
      <view wx:for="{{slots}}" wx:key="ts"
            class="slot {{item.busy ? 'slot--busy' : 'slot--free'}} {{pickedSlot === item.ts ? 'slot--on' : ''}}"
            data-ts="{{item.ts}}" bindtap="pickSlot">{{item.label}}</view>
    </view>
  </view>

  <!-- 第 2 步：项目 -->
  <view class="glass" wx:if="{{step === 2}}">
    <view class="row row--between">
      <text class="h2">选项目</text>
      <text class="muted">按项目时长自动锁时段</text>
    </view>
    <view class="items mt16">
      <view wx:for="{{items}}" wx:key="_id"
            class="cardx {{pickedItem === item._id ? 'cardx--on' : ''}}"
            data-id="{{item._id}}" bindtap="pickItem">
        <view class="item__ico ico ico--{{item.icon}}"></view>
        <view class="grow">
          <view class="item__t">{{item.name}}</view>
          <view class="item__s">{{item.duration}} 分钟</view>
        </view>
        <view class="num--sm">¥{{item.price}}</view>
      </view>
    </view>
  </view>

  <!-- 第 3 步：客人属性 -->
  <view class="glass" wx:if="{{step === 3}}">
    <view class="row row--between">
      <text class="h2">客人属性</text>
      <text class="muted">用于统计</text>
    </view>
    <view class="grid4 mt20">
      <view wx:for="{{types}}" wx:key="k"
            class="type {{pickedType === item.k ? 'type--on' : ''}}"
            data-k="{{item.k}}" bindtap="pickType">
        <view class="type__ico">{{item.ico}}</view>
        <view class="type__t">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 汇总 -->
  <view class="glass">
    <view class="row row--between"><text class="muted">时间</text><text>{{summary.time}}</text></view>
    <view class="row row--between mt12"><text class="muted">项目</text><text>{{summary.item}}</text></view>
    <view class="row row--between mt12"><text class="muted">客人</text><text>{{summary.type}}</text></view>
    <view class="divider"></view>
    <view class="row row--between"><text class="muted">预计价格</text><view class="num--sm">¥{{summary.price}}</view></view>
    <view class="muted mt12">预付款仅在同一时间段内优先，不跨时段插队。</view>
  </view>

  <view class="stick">
    <view class="btn {{canSubmit ? 'btn--gold' : 'btn--gold btn--disabled'}}" bindtap="submit">确认预约</view>
  </view>
</view>
