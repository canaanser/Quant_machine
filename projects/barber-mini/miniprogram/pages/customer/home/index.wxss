/* 24 小时时间轴（从现在到打烊） */
.tl24 { background: var(--glass); border: 1rpx solid var(--glass-line); border-radius: 28rpx;
  padding: 24rpx 26rpx; margin-bottom: 24rpx; box-shadow: var(--shadow);
  backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx); }
.tl24__head { display: flex; justify-content: space-between; margin-bottom: 14rpx; }
.tl24__track { position: relative; height: 78rpx; border-radius: 20rpx; background: rgba(20,22,26,.06); overflow: hidden; }
.tl24__rest { position: absolute; left: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, rgba(201,162,39,.18), rgba(201,162,39,.40)); }
.tl24__now { position: absolute; top: 0; bottom: 0; width: 4rpx; background: var(--gold); }
.tl24__dot { position: absolute; top: 6rpx; transform: translateX(-50%); }
.tl24__face { font-size: 42rpx; }
.tl24__foot { display: flex; justify-content: space-between; margin-top: 10rpx; }

/* 类型/项目选择 */
.pick { padding: 18rpx 0; border-radius: 22rpx; text-align: center;
  background: rgba(255,255,255,.55); border: 1rpx solid var(--glass-line); }
.pick--on { border-color: var(--gold); background: rgba(255,246,218,.92); }
.pick__ico { font-size: 42rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.pick__t { font-size: 26rpx; margin-top: 6rpx; font-weight: 600; }
.pick__s { font-size: 22rpx; color: var(--ink-3); }
