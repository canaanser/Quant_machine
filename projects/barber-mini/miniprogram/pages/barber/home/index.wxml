<view class="bg">
  <view class="bg__blob bg__blob--a"></view>
  <view class="bg__blob bg__blob--b"></view>
  <view class="bg__blob bg__blob--c"></view>
</view>

<view class="page">
  <view class="row row--between" style="margin-bottom:22rpx">
    <view class="row row--gap">
      <view class="ava">明</view>
      <view>
        <view class="h1" style="font-size:38rpx">阿明</view>
        <view class="lbl">工号 b1 · 今日营业</view>
      </view>
    </view>
    <view class="pill pill--{{tone}}">
      <view class="dot dot--{{tone}} {{tone === 'busy' ? 'dot--pulse' : ''}}"></view>{{statusText}}
    </view>
  </view>

  <!-- ① 顾客端同款状态卡（经营者也一眼看到"现在多少人"） -->
  <view class="status status--{{tone}}">
    <view class="row row--between">
      <view>
        <view class="lbl" style="color:rgba(255,255,255,.72)">顾客看到的状态</view>
        <view class="status__big">{{statusText}}</view>
        <view class="lbl" style="color:rgba(255,255,255,.85)">当前共 {{queue.length}} 位在队/在服务</view>
      </view>
      <view class="center">
        <view class="num" style="color:#fff">{{queue.length}}</view>
        <view class="lbl" style="color:rgba(255,255,255,.72)">位</view>
      </view>
    </view>
  </view>

  <view class="tiles">
    <view class="tile"><view class="tile__k">今日单数</view><view class="tile__v">{{today}}<text class="tile__u">单</text></view></view>
    <view class="tile"><view class="tile__k">今日收入</view><view class="tile__v">{{hideMoney ? '∗∗∗' : revenue}}<text class="tile__u">元</text></view></view>
    <view class="tile"><view class="tile__k">平均耗时</view><view class="tile__v">{{avgMin}}<text class="tile__u">分</text></view></view>
  </view>

  <!-- ② 排队与积压（第一眼要看的就是这个） -->
  <view class="glass mt24">
    <view class="row row--between">
      <view class="sec" style="margin-bottom:0"><view class="sec__bar"></view><text class="sec__t" style="font-size:30rpx">排队与积压</text></view>
      <view class="pill">{{queue.length}} 位在队</view>
    </view>
    <view class="tiles mt16">
      <view class="tile"><view class="tile__k">等待中</view><view class="tile__v">{{waitingCount}}<text class="tile__u">位</text></view></view>
      <view class="tile"><view class="tile__k">服务中</view><view class="tile__v">{{servingId ? 1 : 0}}<text class="tile__u">位</text></view></view>
      <view class="tile"><view class="tile__k">已预约</view><view class="tile__v">{{reservedCount}}<text class="tile__u">位</text></view></view>
    </view>
    <view class="muted mt12">{{queue.length > 3 ? '积压偏多，加把劲 💪' : (queue.length ? '队伍正常，稳住节奏' : '现在没人排队，休息一下')}}</view>
  </view>

  <!-- 今日目标：给自己一个进度条（要的就是"有干劲"） -->
  <view class="glass glass--tight mt24">
    <view class="row row--between">
      <view class="row row--gap">
        <view class="sec__bar"></view>
        <text class="item__t">今日目标 ¥{{hideMoney ? '∗∗∗' : goal}}</text>
      </view>
      <view class="row row--gap">
        <text class="muted">{{goalPct}}% · 还差 {{hideMoney ? '∗∗∗' : ('¥' + goalLeft)}}</text>
        <view class="pill" id="eyeBtn" bindtap="toggleEye">{{hideMoney ? '显示' : '隐藏'}}</view>
      </view>
    </view>
    <view class="bar mt16"><view class="bar__in" style="width:{{goalPct}}%"></view></view>
    <view class="row row--gap mt16">
      <view class="btn btn--ghost btn--sm grow" id="boardBtn" bindtap="goBoard">数据看板</view>
      <view class="btn btn--ghost btn--sm grow" id="settingsBtn" bindtap="goSettings">设置</view>
    </view>
  </view>

  <view class="glass glass--dark mt24">
    <view class="row row--between">
      <view class="grow">
        <view class="lbl" style="color:rgba(255,255,255,.62)">当前服务</view>
        <view class="h1" style="color:#fff;margin-top:10rpx;font-size:38rpx">{{currentName}}</view>
        <view class="muted" style="color:rgba(255,255,255,.72);margin-top:8rpx">已用 {{elapsed}} 分钟 · {{currentItem}}（预估 {{servingPlanMin}} 分钟）</view>
        <view wx:if="{{overtime > 0}}" class="pill pill--rest" style="margin-top:12rpx">已超时 {{overtime}} 分钟 · 记得点「完成本单」</view>
      </view>
      <view class="center">
        <view class="num" style="color:#fff">{{elapsed}}</view>
        <view class="lbl" style="color:rgba(255,255,255,.62)">分钟</view>
      </view>
    </view>
    <view class="btn btn--gold mt20" id="finishBtn" bindtap="finish">完成本单</view>
  </view>

  <view class="glass">
    <view class="row row--between">
      <text class="h2">接单状态</text>
      <text class="muted">顾客端会立刻看到</text>
    </view>
    <view class="seg mt16">
      <view class="seg__i {{status === 'idle' ? 'seg__i--on' : ''}}" id="stIdle" data-s="idle" bindtap="setStatus">空闲</view>
      <view class="seg__i {{status === 'busy' ? 'seg__i--on' : ''}}" id="stBusy" data-s="busy" bindtap="setStatus">忙</view>
      <view class="seg__i {{status === 'rest' ? 'seg__i--on' : ''}}" id="stRest" data-s="rest" bindtap="setStatus">休息</view>
    </view>
  </view>

  <!-- 调试专用：让队列自动滚动（生产环境请勿开启） -->
  <view class="glass glass--tight">
    <view class="row row--between">
      <view class="grow">
        <view class="row row--gap">
          <text class="item__t">调试：队列自动滚动</text>
          <view class="pill {{autoFlow ? 'pill--gold' : ''}}">{{autoFlow ? '开' : '关'}}</view>
        </view>
        <view class="muted mt8">开着时每 4 秒自动：到点的单完成 → 下一位自动开始（**仅调试用**）</view>
      </view>
      <view class="seg" style="width:200rpx">
        <view class="seg__i {{autoFlow ? '' : 'seg__i--on'}}" id="flowOff" bindtap="toggleFlow" data-v="off">关</view>
        <view class="seg__i {{autoFlow ? 'seg__i--on' : ''}}" id="flowOn" bindtap="toggleFlow" data-v="on">开</view>
      </view>
    </view>
  </view>

  <view class="glass">
    <view class="row row--between">
      <text class="h2">快捷接单</text>
      <view class="pill">{{clickCount}} 击</view>
    </view>
    <view class="muted mt8">选客人 → 选项目 → 开始服务</view>
    <view class="grid4 mt16">
      <view wx:for="{{types}}" wx:key="k" id="type-{{item.k}}" class="type {{picked === item.k ? 'type--on' : ''}}"
            data-k="{{item.k}}" bindtap="pickType">
        <view class="type__ico">{{item.ico}}</view>
        <view class="type__t">{{item.label}}</view>
      </view>
    </view>
    <view class="grid3 mt16">
      <view wx:for="{{items}}" wx:key="_id" id="item-{{item._id}}" class="type {{itemPicked === item._id ? 'type--on' : ''}}"
            data-id="{{item._id}}" bindtap="pickItem">
        <view class="type__t" style="font-size:28rpx;font-weight:600">{{item.name}}</view>
        <view class="type__t">¥{{item.price}}</view>
      </view>
    </view>
    <view class="btn btn--gold mt20" id="startBtn" bindtap="start">开始服务</view>
  </view>

  <view class="glass">
    <view class="row row--between">
      <text class="h2">排队（{{queue.length}}）</text>
      <text class="muted">预付款同段优先</text>
    </view>
    <view wx:if="{{queue.length}}">
      <view class="item" wx:for="{{queue}}" wx:key="_id">
        <view class="rank {{index === 0 ? 'rank--on' : ''}}">{{index + 1}}</view>
        <view class="grow">
          <view class="item__t">{{item.name}}</view>
          <view class="item__s">{{item.serviceName}} · {{item.statusText}}</view>
        </view>
        <view class="pill {{item.tagClass}}">{{item.tag}}</view>
      </view>
    </view>
    <view wx:else class="center" style="padding:30rpx 0">
      <text class="muted">现在没人排队，休息一下</text>
    </view>
  </view>
</view>
