.chart__row { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; }
.chart__k { width: 110rpx; font-size: 26rpx; color: var(--ink-2); }
.chart__track { flex: 1; height: 22rpx; border-radius: 999rpx; background: rgba(20,22,26,.07); overflow: hidden; }
.chart__bar { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, var(--gold-2), var(--gold)); }
.chart__v { width: 210rpx; text-align: right; font-size: 22rpx; color: var(--ink-3); }

.donut { width: 180rpx; height: 180rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: conic-gradient(var(--gold) 0deg 140deg, var(--free) 140deg 250deg, #8FB4FF 250deg 320deg, #E5484D 320deg 360deg); }
.donut__in { width: 128rpx; height: 128rpx; border-radius: 50%; background: rgba(255,255,255,.92);
  display: flex; flex-direction: column; align-items: center; justify-content: center; }
.legend { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 0; font-size: 26rpx; }

.bars { display: flex; align-items: flex-end; gap: 14rpx; height: 220rpx; }
.bars__i { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 10rpx; }
.bars__b { width: 100%; border-radius: 10rpx 10rpx 6rpx 6rpx; background: linear-gradient(180deg, var(--gold-2), var(--gold)); min-height: 12rpx; }
