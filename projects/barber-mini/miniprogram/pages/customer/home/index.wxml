<view class="bg">
  <view class="bg__blob bg__blob--a"></view>
  <view class="bg__blob bg__blob--b"></view>
  <view class="bg__blob bg__blob--c"></view>
</view>

<view class="page">
  <!-- 店头 -->
  <view class="head">
    <view class="head__ava">明</view>
    <view class="grow">
      <view class="head__name">阿明理发</view>
      <view class="head__sub">今天营业 {{openTime}}–{{closeTime}} · 更新 {{nowText}}</view>
    </view>
    <view class="pill pill--{{tone}}">
      <view class="dot dot--{{tone}} dot--pulse"></view>{{statusText}}
    </view>
  </view>

  <!-- ① 24 小时时间轴：从现在到打烊，后面每一位都在轴上（排队+预约合计） -->
  <view class="tl24">
    <view class="tl24__head">
      <text class="lbl">现在 {{nowText}} → 打烊 {{closeTime}}</text>
      <text class="lbl">后面 {{behindCount}} 位（排队 {{cntQueuing}} · 预约 {{cntReserved}}）</text>
    </view>
    <!-- 色条时间轴：最左=正在服务(橙)，往右依次是排队(金)/预约(蓝)；右端=打烊 -->
    <view class="tlbar">
      <view class="tlbar__pad"></view>
      <view wx:for="{{segs}}" wx:key="i" class="tlbar__seg tlbar__seg--{{item.k}}" style="flex:{{item.w}}">
        <text class="tlbar__t">{{item.t}}</text>
      </view>
      <view class="tlbar__rest"></view>
    </view>
    <view class="tl24__foot">
      <text class="lbl">▲ 现在</text>
      <text class="lbl">橙=正在服务 · 金=排队 · 蓝=预约</text>
      <text class="lbl">打烊 {{closeTime}}</text>
    </view>
  </view>

  <!-- ② 状态卡：现在忙不忙、要等多久 -->
  <view class="glass glass--dark">
    <view class="row row--between">
      <view class="grow">
        <view class="lbl" style="color:rgba(255,255,255,.62)">当前状态</view>
        <view class="h1" style="color:#fff;margin-top:10rpx">{{statusText}}</view>
        <view class="muted" style="color:rgba(255,255,255,.72);margin-top:8rpx">{{statusSub}}</view>
      </view>
      <view class="center">
        <view class="num" style="color:#fff">{{etaMin}}</view>
        <view class="lbl" style="color:rgba(255,255,255,.62)">预计分钟</view>
      </view>
    </view>
    <view class="bar mt20" style="background:rgba(255,255,255,.18)">
      <view class="bar__in" style="width:{{progress}}%"></view>
    </view>
    <view class="row row--between mt12">
      <text class="muted" style="color:rgba(255,255,255,.72)">前面 {{waiting}} 位</text>
      <text class="muted" style="color:rgba(255,255,255,.72)">今日已服务 {{done}} 单</text>
    </view>
  </view>

  <!-- ③ 先选"我是谁 / 做什么"，再决定排队还是预约 -->
  <block wx:if="{{!mine}}">
  <view class="glass">
    <view class="sec"><view class="sec__bar"></view><text class="sec__t" style="font-size:30rpx">我是谁</text></view>
    <view class="grid4">
      <view wx:for="{{types}}" wx:key="k" id="ctype-{{item.k}}" class="pick {{pickedType === item.k ? 'pick--on' : ''}}"
            data-k="{{item.k}}" bindtap="pickType">
        <view class="pick__ico">{{item.ico}}</view>
        <view class="pick__t">{{item.label}}</view>
      </view>
    </view>
    <view class="sec mt24"><view class="sec__bar"></view><text class="sec__t" style="font-size:30rpx">做什么</text></view>
    <view class="grid4">
      <view wx:for="{{items}}" wx:key="_id" id="citem-{{item._id}}" class="pick {{pickedItem === item._id ? 'pick--on' : ''}}"
            data-id="{{item._id}}" bindtap="pickItem">
        <view class="pick__ico ico ico--{{item.icon}}"></view>
        <view class="pick__t">{{item.name}}</view>
        <view class="pick__s">{{item.min}}分 ¥{{item.price}}</view>
      </view>
    </view>
  </view>

  <!-- ④ 两个动作：**排队在左（主）**，预约在右（提前预约） -->
  <view class="grid2">
    <view class="btn btn--gold" id="joinBtn" bindtap="joinQueue">立即排队</view>
    <view class="btn btn--ghost" id="bookBtn" bindtap="goBook">提前预约</view>
  </view>
  </block>

  <!-- 已经在排队/已预约：**不再给排队和预约**（否则他会重复排），中间换成店里动态场景 + 一个"我的排队" -->
  <block wx:else>
    <shop-scene text="{{sceneText}}"></shop-scene>
    <view class="glass mt24">
      <view class="row row--between">
        <view>
          <view class="item__t">我的{{mine.tag === '已预约' ? '预约' : '排队'}}</view>
          <view class="item__s">{{mine.serviceName}} · {{mine.statusText}} · {{mine.eta}}</view>
        </view>
        <view class="btn btn--gold btn--sm" style="width:220rpx" id="myQueue" bindtap="goProgress">看排队进度</view>
      </view>
    </view>
  </block>

  <!-- 我的单 -->
  <view class="glass mt24" wx:if="{{mine}}">
    <view class="row row--between">
      <text class="h2">我的单</text>
      <view class="pill pill--gold">{{mine.tag}}</view>
    </view>
    <view class="row row--between mt16">
      <view>
        <view class="item__t">{{mine.serviceName}}</view>
        <view class="item__s">{{mine.statusText}}</view>
      </view>
      <view class="num--sm">{{mine.eta}}</view>
    </view>
    <view class="bar mt16"><view class="bar__in" style="width:{{mine.progress}}%"></view></view>
  </view>

  <view class="glass glass--tight center">
    <text class="muted">预付款仅在同一时间段内优先，不跨时段插队</text>
  </view>
</view>
