<view class="bg">
  <view class="bg__blob bg__blob--a"></view>
  <view class="bg__blob bg__blob--b"></view>
</view>

<view class="page">
  <view class="row row--between" style="margin:6rpx 4rpx 26rpx">
    <view>
      <view class="lbl">价格 / 时长 / 目标 / 营业时间</view>
      <view class="h1">设置</view>
    </view>
  </view>

  <!-- 今日目标 -->
  <view class="glass">
    <view class="row row--between">
      <text class="item__t">今日目标</text>
      <view class="row row--gap">
        <text class="num--sm" id="goalVal">{{hideMoney ? '∗∗∗' : ('¥' + goal)}}</text>
        <view class="pill" id="eyeBtn" bindtap="toggleEye">{{hideMoney ? '显示' : '隐藏'}}</view>
      </view>
    </view>
    <view class="btn btn--ghost btn--sm mt16" id="goalBtn" bindtap="setGoal">改目标</view>
  </view>

  <!-- 营业时间 -->
  <view class="glass">
    <view class="sec"><view class="sec__bar"></view><text class="sec__t" style="font-size:30rpx">营业时间</text></view>
    <view class="row row--gap">
      <view class="field grow"><text class="lbl">开门</text>
        <picker mode="time" value="{{openTime}}" data-k="openTime" bindchange="onTime"><view class="inp">{{openTime}}</view></picker>
      </view>
      <view class="field grow"><text class="lbl">打烊</text>
        <picker mode="time" value="{{closeTime}}" data-k="closeTime" bindchange="onTime"><view class="inp">{{closeTime}}</view></picker>
      </view>
    </view>
    <view class="btn btn--gold btn--sm mt16" id="saveHours" bindtap="saveHours">保存营业时间</view>
  </view>

  <!-- 服务项目（含预设图标） -->
  <view class="glass">
    <view class="row row--between">
      <view class="sec" style="margin-bottom:0"><view class="sec__bar"></view><text class="sec__t" style="font-size:30rpx">服务项目</text></view>
      <view class="pill pill--gold" id="newBtn" bindtap="openNew">＋ 新增</view>
    </view>

    <view wx:if="{{edit}}" class="editbox mt20">
      <view class="field"><text class="lbl">名称</text><input class="inp" value="{{form.name}}" data-k="name" bindinput="onInput" placeholder="例：剪发" /></view>
      <view class="row row--gap mt16">
        <view class="field grow"><text class="lbl">价格(元)</text><input class="inp" type="number" value="{{form.price}}" data-k="price" bindinput="onInput" /></view>
        <view class="field grow"><text class="lbl">时长(分钟)</text><input class="inp" type="number" value="{{form.min}}" data-k="min" bindinput="onInput" /></view>
      </view>
      <view class="lbl mt20">选个图标</view>
      <view class="row row--gap mt12">
        <view wx:for="{{icons}}" wx:key="k" class="pickico ico ico--{{item.k}} {{form.icon === item.k ? 'pickico--on' : ''}}"
              id="ico-{{item.k}}" data-k="{{item.k}}" bindtap="pickIcon"></view>
      </view>
      <view class="row row--gap mt20">
        <view class="btn btn--ghost btn--sm grow" id="cancelEdit" bindtap="close">取消</view>
        <view class="btn btn--gold btn--sm grow" id="saveBtn" bindtap="save">{{saving ? '保存中…' : '保存'}}</view>
      </view>
    </view>

    <view class="item" wx:for="{{list}}" wx:key="_id">
      <view class="item__ico ico ico--{{item.icon}}"></view>
      <view class="grow" id="edit-{{item._id}}" data-id="{{item._id}}" bindtap="openEdit">
        <view class="item__t">{{item.name}}{{item.on ? '' : '（已下架）'}}</view>
        <view class="item__s">{{item.min}} 分钟 · ¥{{hideMoney ? '∗∗∗' : item.price}}</view>
      </view>
      <view class="pill {{item.on ? 'pill--free' : ''}}" id="toggle-{{item._id}}" data-id="{{item._id}}" bindtap="toggle">{{item.on ? '上架中' : '已下架'}}</view>
    </view>
  </view>

  <view class="glass glass--tight">
    <view class="btn btn--ghost btn--sm" id="ledgerBtn" bindtap="goLedger">查看今日流水</view>
  </view>
</view>
