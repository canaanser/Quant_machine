/* 24 小时时间轴（从现在到打烊） */
.tl24 { background: var(--glass); border: 1rpx solid var(--glass-line); border-radius: 28rpx;
  padding: 24rpx 26rpx; margin-bottom: 24rpx; box-shadow: var(--shadow);
  backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx); }
.tl24__head { display: flex; justify-content: space-between; margin-bottom: 14rpx; }
.tlbar { display: flex; align-items: stretch; height: 64rpx; border-radius: 18rpx;
  background: rgba(20,22,26,.06); overflow: hidden; }
.tlbar__pad { width: 10rpx; flex: 0 0 auto; }              /* 最左留一点空余，看着舒服 */
.tlbar__seg { display: flex; align-items: center; justify-content: center; margin-right: 6rpx;
  border-radius: 14rpx; min-width: 56rpx; }
.tlbar__seg--serving { background: linear-gradient(135deg, #F7C25A, #F0A020); color: #3A2A00; }
.tlbar__seg--queuing { background: linear-gradient(135deg, #F6E7B4, #E8C766); color: #5A4600; }
.tlbar__seg--reserved { background: linear-gradient(135deg, #D6E4FF, #9FC2FF); color: #1E3A6E; }
.tlbar__t { font-size: 22rpx; font-weight: 700; }
.tlbar__rest { flex: 1 1 auto; margin-right: 6rpx; border-radius: 14rpx;
  background: repeating-linear-gradient(45deg, rgba(20,22,26,.05) 0 10rpx, rgba(20,22,26,.09) 10rpx 20rpx); }
.tl24__foot { display: flex; justify-content: space-between; margin-top: 10rpx; }

/* 类型/项目选择 */
.pick { padding: 18rpx 0; border-radius: 22rpx; text-align: center;
  background: rgba(255,255,255,.55); border: 1rpx solid var(--glass-line); }
.pick--on { border-color: var(--gold); background: rgba(255,246,218,.92); }
.pick__ico { font-size: 42rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.pick__t { font-size: 26rpx; margin-top: 6rpx; font-weight: 600; }
.pick__s { font-size: 22rpx; color: var(--ink-3); }
