<view class="bg">
  <view class="bg__blob bg__blob--a"></view>
  <view class="bg__blob bg__blob--b"></view>
</view>

<!-- 两屏：左滑看第二屏（接单/工具）。第一屏只放"急事"。 -->
<swiper class="sw {{theme}}" bindchange="onSwipe" current="{{page}}">
  <!-- ============ 第 1 屏：急事 ============ -->
  <swiper-item>
    <scroll-view scroll-y class="pane">
      <!-- 手上还有几位（最醒目） -->
      <view class="hero hero--{{tone}}">
        <view class="row row--between">
          <view>
            <view class="hero__k">手上还有</view>
            <view class="row" style="align-items:flex-end">
              <text class="hero__n">{{queue.length}}</text>
              <text class="hero__u">位</text>
            </view>
          </view>
          <view class="hero__right">
            <view class="row row--gap"><view class="dot dot--{{tone}} dot--pulse"></view><text class="hero__st">{{statusText}}</text></view>
            <view class="hero__sub">当前服务 {{elapsed}} 分钟{{overtime > 0 ? '（已超时 ' + overtime + ' 分钟）' : ''}}</view>
          </view>
        </view>
      </view>

      <!-- 现在这位：头像 + 名字 + 项目，一扫就看到 -->
      <view class="now" id="dropNow">
        <view class="now__ava ava-line ava-line--{{currentFaceKey}}"></view>
        <view class="grow">
          <view class="now__name">{{currentName}}</view>
          <view class="now__meta">{{currentItem}} · {{currentTypeText}}{{currentTag ? ' · ' + currentTag : ''}}</view>
        </view>
        <view class="now__min">{{elapsed}}<text class="now__minu">分</text></view>
      </view>

      <!-- 排队的人：横向头像条（不占地方，一眼扫完"还剩谁、什么活"） -->
      <view class="strip" wx:if="{{queue.length}}">
        <scroll-view scroll-x class="strip__in">
          <view class="face-card" wx:for="{{queue}}" wx:key="_id">
            <view class="face-card__ava ava-line ava-line--{{item.faceKey}}"></view>
            <view class="face-card__name">{{item.name}}</view>
            <view class="face-card__svc">{{item.serviceName}}</view>
          </view>
        </scroll-view>
      </view>
      <view wx:else class="glass glass--tight center" style="margin:0 0 200rpx">
        <text class="muted">现在没人排队，可以歇一会儿</text>
      </view>

      <view style="height:220rpx"></view>
    </scroll-view>

    <!-- 拇指区：完成本单（固定在底部，永远点得到） -->
    <view class="thumbbar">
      <view class="btn btn--gold thumbbtn {{servingId ? '' : 'btn--disabled'}}" id="finishBtn" bindtap="finish">
        {{servingId ? '完成本单' : '当前没有在服务的单'}}
      </view>
      <view class="muted center mt8" wx:if="{{!relay.show}}">忙的时候只需要这一个键；接单在右边一屏 →</view>

      <!-- 接力条：完成本单后滑出。往上拖松手=继续；1 秒不动=休息 -->
      <view class="relay {{relay.show ? 'relay--in' : ''}}" wx:if="{{relay.show}}">
        <view class="relay__bar"><view class="relay__fill" style="width:{{relay.pct}}%"></view></view>
        <view class="relay__row">
          <view class="relay__card" id="relayCard"
                style="transform: translateY({{relay.dragY}}rpx);"
                bindtouchstart="relayStart" catchtouchmove="relayMove" bindtouchend="relayEnd">
            <view class="relay__ava ava-line ava-line--{{relay.next.faceKey}}"></view>
            <view class="grow">
              <view class="item__t">{{relay.next.name}}</view>
              <view class="item__s">{{relay.next.serviceName}} · {{relay.next.tag}}</view>
            </view>
            <view class="relay__hint">↑ 拖我 = 继续</view>
          </view>
        </view>
        <view class="relay__foot">
          <text class="muted">{{relay.counting ? '往上拖到「现在这位」松手＝接他；' + relay.left + ' 秒不动＝回到空闲' : '已回到空闲'}}</text>
          <view class="pill" wx:if="{{!relay.counting}}" id="resumeBtn" bindtap="resumeWork">继续接单</view>
        </view>
      </view>
    </view>
  </swiper-item>

  <!-- ============ 第 2 屏：工具与接单 ============ -->
  <swiper-item>
    <scroll-view scroll-y class="pane">
      <view class="glass">
        <view class="row row--between">
          <text class="h2">快捷接单</text>
          <text class="muted">≤3 击</text>
        </view>
        <view class="grid4 mt16">
          <view wx:for="{{types}}" wx:key="k" id="type-{{item.k}}" class="type {{picked === item.k ? 'type--on' : ''}}"
                data-k="{{item.k}}" bindtap="pickType">
            <view class="type__ico">{{item.ico}}</view>
            <view class="type__t">{{item.label}}</view>
          </view>
        </view>
        <view class="grid3 mt16">
          <view wx:for="{{items}}" wx:key="_id" id="item-{{item._id}}" class="type {{itemPicked === item._id ? 'type--on' : ''}}"
                data-id="{{item._id}}" bindtap="pickItem">
            <view class="type__t" style="font-size:28rpx;font-weight:600">{{item.name}}</view>
            <view class="type__t">¥{{item.price}}</view>
          </view>
        </view>
        <view class="btn btn--gold mt20" id="startBtn" bindtap="start">开始服务</view>
      </view>

      <view class="glass">
        <view class="row row--between">
          <text class="h2">接单状态</text>
          <text class="muted">顾客端会立刻看到</text>
        </view>
        <!-- 顺序按老板定的：左→右 = 忙 / 空闲 / 打烊 -->
        <view class="seg mt16">
          <view class="seg__i {{status === 'busy' ? 'seg__i--on' : ''}}" id="stBusy" data-s="busy" bindtap="setStatus">忙</view>
          <view class="seg__i {{status === 'idle' ? 'seg__i--on' : ''}}" id="stIdle" data-s="idle" bindtap="setStatus">空闲</view>
          <view class="seg__i {{status === 'rest' ? 'seg__i--on' : ''}}" id="stRest" data-s="rest" bindtap="setStatus">打烊</view>
        </view>
      </view>

      <!-- 排队明细不再重复列（第一屏的头像条已经够了），只留一个入口 -->
      <view class="glass glass--tight">
        <view class="row row--between" id="queueAll" bindtap="goQueue">
          <view>
            <view class="item__t">排队详情</view>
            <view class="item__s">{{queue.length}} 位 · 顺序与规则</view>
          </view>
          <text class="muted">去看 ›</text>
        </view>
      </view>

      <view class="grid2">
        <view class="entry" id="boardBtn" bindtap="goBoard"><view class="entry__t">数据看板</view><view class="entry__s">目标 · 排行 · 客户</view></view>
        <view class="entry" id="ledgerBtn" bindtap="goLedger"><view class="entry__t">今日流水</view><view class="entry__s">逐单对账</view></view>
        <view class="entry" id="settingsBtn" bindtap="goSettings"><view class="entry__t">设置</view><view class="entry__s">营业时间 · 项目</view></view>
        <view class="entry" id="queueBtn2" bindtap="goQueue"><view class="entry__t">排队管理</view><view class="entry__s">全部队伍与规则</view></view>
      </view>
      <view style="height:60rpx"></view>
    </scroll-view>
  </swiper-item>
</swiper>
