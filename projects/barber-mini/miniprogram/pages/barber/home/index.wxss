.ava { width: 88rpx; height: 88rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 700; color: #2A2205;
  background: linear-gradient(135deg, var(--gold-2), var(--gold)); box-shadow: 0 8rpx 20rpx rgba(201,162,39,.35); }
.rank { width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; border-radius: 16rpx;
  background: rgba(20,22,26,.06); color: var(--ink-3); font-weight: 700; font-size: 26rpx; }
.rank--on { background: linear-gradient(135deg, var(--gold-2), var(--gold)); color: #2A2205; }
.type { padding: 20rpx 0; border-radius: 22rpx; text-align: center;
  background: rgba(255,255,255,.55); border: 1rpx solid var(--glass-line); }
.type--on { border-color: var(--gold); background: rgba(255,246,218,.9); }
.type__ico { font-size: 40rpx; }
.type__t { font-size: 24rpx; margin-top: 6rpx; color: var(--ink-2); }
