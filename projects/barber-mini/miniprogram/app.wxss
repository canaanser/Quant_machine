/* ── 设计系统（一处定义，六页共用）────────────────────────────────────────────
   风格：扁平 + 简约 + 毛玻璃半透明；深灰墨 + 金点缀；状态色只用于状态。
   层级：背景光斑 → 玻璃卡 → 内容；数字用重字重，标签用弱色。              */

page {
  --ink: #14161A;
  --ink-2: #3A3F47;
  --ink-3: #7C838E;
  --gold: #C9A227;
  --gold-2: #E8C766;
  --free: #17B26A;
  --busy: #F0A020;
  --rest: #E5484D;
  --glass: rgba(255, 255, 255, 0.72);
  --glass-2: rgba(255, 255, 255, 0.52);
  --glass-line: rgba(255, 255, 255, 0.65);
  --stroke: rgba(20, 22, 26, 0.08);
  --shadow: 0 8rpx 32rpx rgba(20, 22, 26, 0.10);
  --radius: 28rpx;

  background: #EEF1F6;
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* 背景光斑：毛玻璃要透出层次才好看 */
.bg { position: fixed; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; z-index: 0; }
.bg__blob { position: absolute; border-radius: 50%; filter: blur(60rpx); opacity: .55; }
.bg__blob--a { width: 520rpx; height: 520rpx; left: -160rpx; top: -120rpx;
  background: radial-gradient(circle at 30% 30%, #FFE9A8, #FFD36E 45%, rgba(255,211,110,0) 70%); }
.bg__blob--b { width: 640rpx; height: 640rpx; right: -220rpx; top: 200rpx;
  background: radial-gradient(circle at 60% 40%, #BFD6FF, #8FB4FF 45%, rgba(143,180,255,0) 72%); }
.bg__blob--c { width: 560rpx; height: 560rpx; left: -120rpx; bottom: -180rpx;
  background: radial-gradient(circle at 40% 60%, #C8F5DF, #86E3B8 45%, rgba(134,227,184,0) 72%); }

.page { position: relative; z-index: 1; padding: 24rpx 24rpx 180rpx; }

/* ── 玻璃卡 ── */
.glass {
  background: var(--glass);
  backdrop-filter: blur(24rpx) saturate(140%);
  -webkit-backdrop-filter: blur(24rpx) saturate(140%);
  border: 1rpx solid var(--glass-line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.glass--tight { padding: 22rpx 24rpx; }
.glass--dark { background: rgba(20, 22, 26, 0.78); color: #fff; border-color: rgba(255,255,255,0.12); }

/* ── 排版 ── */
.h1 { font-size: 44rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.h2 { font-size: 34rpx; font-weight: 600; }
.lbl { font-size: 24rpx; color: var(--ink-3); letter-spacing: 1rpx; }
.muted { color: var(--ink-3); font-size: 24rpx; }
.num { font-size: 56rpx; font-weight: 700; letter-spacing: -1rpx; }
.num--sm { font-size: 36rpx; font-weight: 700; }
.row { display: flex; align-items: center; }
.row--between { justify-content: space-between; }
.row--gap { gap: 16rpx; }
.col { display: flex; flex-direction: column; }
.grow { flex: 1; }

/* ── 药丸 / 徽标 ── */
.pill { display: inline-flex; align-items: center; gap: 8rpx; padding: 8rpx 18rpx;
  border-radius: 999rpx; font-size: 22rpx; background: rgba(20,22,26,0.06); color: var(--ink-2); }
.pill--gold { background: linear-gradient(135deg, #F6E7B4, #E8C766); color: #6B5210; font-weight: 600; }
.pill--free { background: rgba(23,178,106,0.14); color: #0E7A48; }
.pill--busy { background: rgba(240,160,32,0.16); color: #8A5A00; }
.pill--rest { background: rgba(229,72,77,0.14); color: #9B2A2E; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.dot--free { background: var(--free); }
.dot--busy { background: var(--busy); }
.dot--rest { background: var(--rest); }
.dot--pulse { animation: pulse 1.6s ease-in-out infinite; }
@keyframes pulse { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.35); opacity: .6; } }

/* ── 按钮 ── */
.btn { height: 100rpx; line-height: 100rpx; border-radius: 24rpx; text-align: center;
  font-size: 32rpx; font-weight: 600; letter-spacing: 1rpx; }
.btn--gold { background: linear-gradient(135deg, var(--gold-2), var(--gold)); color: #2A2205;
  box-shadow: 0 10rpx 28rpx rgba(201,162,39,0.35); }
.btn--dark { background: var(--ink); color: #fff; }
.btn--ghost { background: var(--glass-2); border: 1rpx solid var(--glass-line); color: var(--ink); }
.btn--disabled { opacity: .45; }
.btn--sm { height: 72rpx; line-height: 72rpx; font-size: 26rpx; border-radius: 18rpx; }

/* ── 统计瓦片：看板用小而密的块 ── */
.tiles { display: flex; gap: 16rpx; }
.tile { flex: 1; background: var(--glass-2); border: 1rpx solid var(--glass-line);
  border-radius: 22rpx; padding: 22rpx 20rpx;
  backdrop-filter: blur(16rpx); -webkit-backdrop-filter: blur(16rpx); }
.tile__k { font-size: 22rpx; color: var(--ink-3); }
.tile__v { font-size: 40rpx; font-weight: 700; margin-top: 6rpx; }
.tile__u { font-size: 22rpx; color: var(--ink-3); margin-left: 6rpx; font-weight: 400; }

/* ── 列表行 ── */
.item { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--stroke); }
.item:last-child { border-bottom: none; }
.item__ico { width: 72rpx; height: 72rpx; border-radius: 22rpx; display: flex; align-items: center;
  justify-content: center; font-size: 34rpx; background: linear-gradient(135deg, #FFF6DA, #F3E3AE); }
.item__t { font-size: 30rpx; font-weight: 600; }
.item__s { font-size: 24rpx; color: var(--ink-3); margin-top: 4rpx; }

/* ── 进度条 ── */
.bar { height: 14rpx; border-radius: 999rpx; background: rgba(20,22,26,0.08); overflow: hidden; }
.bar__in { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, var(--gold-2), var(--gold)); }

/* ── 分段控件 ── */
.seg { display: flex; background: rgba(20,22,26,0.06); border-radius: 20rpx; padding: 6rpx; }
.seg__i { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 16rpx; font-size: 26rpx; color: var(--ink-2); }
.seg__i--on { background: #fff; box-shadow: 0 4rpx 14rpx rgba(20,22,26,.10); font-weight: 600; color: var(--ink); }

/* ── 时间轴格子 ── */
.slots { display: flex; flex-wrap: wrap; gap: 14rpx; }
.slot { min-width: 148rpx; padding: 20rpx 0; text-align: center; border-radius: 20rpx;
  font-size: 26rpx; font-weight: 600; }
.slot--free { background: rgba(23,178,106,0.12); color: #0E7A48; border: 1rpx solid rgba(23,178,106,0.25); }
.slot--busy { background: rgba(20,22,26,0.06); color: #9AA1AC; }
.slot--on { background: linear-gradient(135deg, var(--gold-2), var(--gold)); color: #2A2205; border-color: transparent; }

/* ── 布局工具 ── */
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16rpx; }
.grid4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 14rpx; }
.stick { position: fixed; left: 24rpx; right: 24rpx; bottom: 32rpx; z-index: 5; }
.divider { height: 1rpx; background: var(--stroke); margin: 20rpx 0; }
.center { text-align: center; }
.mt8 { margin-top: 8rpx; } .mt12 { margin-top: 12rpx; } .mt16 { margin-top: 16rpx; }
.mt20 { margin-top: 20rpx; } .mt24 { margin-top: 24rpx; }
