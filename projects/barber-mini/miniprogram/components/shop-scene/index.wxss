.sc { border-radius: 28rpx; overflow: hidden; background: linear-gradient(160deg, #FFF7E0 0%, #EAF3FF 60%, #E6F7EF 100%);
  border: 1rpx solid var(--glass-line); box-shadow: var(--shadow); }
.sc__room { position: relative; height: 300rpx; }
/* 镜子（斜视角，落在左上） */
.sc__mirror { position: absolute; left: 40rpx; top: 26rpx; width: 150rpx; height: 90rpx; border-radius: 14rpx;
  background: linear-gradient(135deg, rgba(255,255,255,.95), rgba(190,220,255,.75));
  transform: skewX(-12deg); box-shadow: inset 0 0 24rpx rgba(255,255,255,.9); }
/* 理发椅 + 客人 */
.sc__chair { position: absolute; left: 58rpx; top: 116rpx; width: 128rpx; }
.sc__seated { font-size: 62rpx; }
.sc__cape { display: block; margin: -18rpx 0 0 6rpx; width: 96rpx; height: 46rpx; border-radius: 12rpx 12rpx 20rpx 20rpx;
  background: linear-gradient(180deg, #FFFFFF, #D9E6FF); box-shadow: 0 4rpx 10rpx rgba(20,22,26,.12); }
/* 理发师 + 剪刀（咔嚓动画） */
.sc__barber { position: absolute; left: 176rpx; top: 118rpx; }
.sc__scissors { font-size: 54rpx; display: inline-block; transform-origin: 30% 70%;
  animation: snip .55s ease-in-out infinite; }
@keyframes snip { 0%,100% { transform: rotate(-12deg) translateY(0); } 50% { transform: rotate(10deg) translateY(6rpx); } }
/* 后排等候的人（各自小动作，错开时间） */
.sc__row { position: absolute; left: 34rpx; right: 24rpx; bottom: 22rpx; display: flex; justify-content: space-between; }
.sc__wait { font-size: 52rpx; opacity: .95; animation: bob 2.4s ease-in-out infinite; }
.sc__wait--1 { animation-delay: 0s; } .sc__wait--2 { animation-delay: .5s; }
.sc__wait--3 { animation-delay: 1s; } .sc__wait--4 { animation-delay: 1.5s; }
@keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8rpx); } }
.sc__cap { padding: 14rpx 20rpx; font-size: 24rpx; color: var(--ink-3); text-align: center;
  background: rgba(255,255,255,.6); }
